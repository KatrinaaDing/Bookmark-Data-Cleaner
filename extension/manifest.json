{
  "name": "Bookmark Data Cleaner",
  "version": "3.0.0",
  "manifest_version": 3,
  "description": "Choose sites and clear their browser data, from bookmarks or detected cookies.",
  "permissions": [
    "bookmarks",
    "browsingData",
    "storage"
  ],
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "130",
  "optional_permissions": [
    "cookies",
    "history"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "incognito": "not_allowed"
}
